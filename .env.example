# Required
GAM_NETWORK_CODE=12345678

# Optional when Application Default Credentials are available through gcloud.
# Never commit the referenced credential file.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Safe defaults
GAM_READ_ONLY=true
GAM_DRY_RUN=true

# CSV allowlists. If networks is empty, GAM_NETWORK_CODE is the only allowed network.
GAM_ALLOWED_ORDER_IDS=
GAM_ALLOWED_NETWORK_CODES=12345678

LOG_LEVEL=info

# Operational safeguards
GAM_REQUEST_TIMEOUT_MS=10000
GAM_MAX_RETRIES=3
GAM_PAGE_SIZE=50
GAM_DEFAULT_LIST_LIMIT=200
GAM_MAX_LIST_LIMIT=2000
GAM_AUDIT_MAX_RESOURCES=10000
GAM_AUDIT_CONCURRENCY=5

# SOAP complements REST for resources and typed mutations not covered by REST.
GAM_SOAP_API_VERSION=v202608
GAM_APPLICATION_NAME=gam-prebid-mcp
GAM_MAX_BULK_CREATE=50
GAM_MAX_BULK_UPDATE=50
GAM_WRITE_BATCH_SIZE=20
GAM_PLAN_STORE_DIR=.gam-prebid-plans
GAM_PLAN_MAX_AGE_MS=86400000

# Prebid is optional. GAM-only tools never require a Prebid configuration.
# Empty means only the MCP process working directory is allowed for file input.
PREBID_CONFIG_ALLOWED_DIRS=
PREBID_MAX_CONFIG_BYTES=1048576
PREBID_MAX_BUCKETS=100000
